#include <stdio.h>
#include <stdlib.h>
#include <math.h>
int gcd(int a, int b) {
    while (b != 0) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}
typedef struct {
    int dx;
    int dy;
} Slope;
int compareSlopes(const void* a, const void* b) {
    Slope* s1 = (Slope*)a;
    Slope* s2 = (Slope*)b;
    if (s1->dx != s2->dx) {
        return (s1->dx > s2->dx) - (s1->dx < s2->dx);
    }
    return (s1->dy > s2->dy) - (s1->dy < s2->dy);
}
int maxPoints(int** points, int pointsSize, int* pointsColSize) {
    if (pointsSize <= 2) return pointsSize;    
    int max_points = 2;
    Slope* slopes = (Slope*)malloc(sizeof(Slope) * pointsSize);    
    for (int i = 0; i < pointsSize; i++) {
        int count = 0;        
        for (int j = 0; j < pointsSize; j++) {
            if (i == j) continue;            
            int dx = points[j][0] - points[i][0];
            int dy = points[j][1] - points[i][1];
            if (dx == 0) {
                dy = 1;
            } else if (dy == 0) {
                dx = 1;
            } else {
                int g = gcd(abs(dx), abs(dy));
                dx /= g;
                dy /= g;
                if (dx < 0) {
                    dx = -dx;
                    dy = -dy;
                }
            }            
            slopes[count].dx = dx;
            slopes[count].dy = dy;
            count++;
        }
        qsort(slopes, count, sizeof(Slope), compareSlopes); 
        int current_max = 1;
        int current_run = 1;
        for (int k = 1; k < count; k++) {
            if (slopes[k].dx == slopes[k-1].dx && slopes[k].dy == slopes[k-1].dy) {
                current_run++;
            } else {
                if (current_run > current_max) current_max = current_run;
                current_run = 1;
            }
        }
        if (current_run > current_max) current_max = current_run;
        if (current_max + 1 > max_points) {
            max_points = current_max + 1;
        }
    }
    free(slopes);
    return max_points;
}
