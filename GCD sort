#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>
#define MAX_VAL 100001
int parent[MAX_VAL];
int findProject(int i) {
    if (parent[i] == i)
        return i;
    return parent[i] = findProject(parent[i]);
}
void unionProject(int i, int j) {
    int rootI = findProject(i);
    int rootJ = findProject(j);
    if (rootI != rootJ) {
        parent[rootI] = rootJ;
    }
}
int compare(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}
bool gcdSort(int* nums, int numsSize) {
    int maxNum = 0;
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] > maxNum) {
            maxNum = nums[i];
        }
    }
    for (int i = 0; i <= maxNum; i++) {
        parent[i] = i;
    }
    int* spf = (int*)malloc((maxNum + 1) * sizeof(int));
    for (int i = 0; i <= maxNum; i++) spf[i] = i;
    for (int i = 2; i * i <= maxNum; i++) {
        if (spf[i] == i) {
            for (int j = i * i; j <= maxNum; j += i) {
                if (spf[j] == j) {
                    spf[j] = i;
                }
            }
        }
    }
    for (int i = 0; i < numsSize; i++) {
        int temp = nums[i];
        while (temp > 1) {
            int factor = spf[temp];
            unionProject(nums[i], factor);
            while (temp % factor == 0) {
                temp /= factor;
            }
        }
    }
    free(spf);
    int* sortedNums = (int*)malloc(numsSize * sizeof(int));
    for (int i = 0; i < numsSize; i++) {
        sortedNums[i] = nums[i];
    }
    qsort(sortedNums, numsSize, sizeof(int), compare);
    for (int i = 0; i < numsSize; i++) {
        if (findProject(nums[i]) != findProject(sortedNums[i])) {
            free(sortedNums);
            return false;
        }
    }
    free(sortedNums);
    return true;
}
